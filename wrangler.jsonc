{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "see-the-spire",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-09-18",
  "observability": {
    "enabled": true
  },
   "d1_databases": [
    {
      "binding": "DB",
      "database_name": "see-the-spire-db",
      "database_id": "11ee83c1-fcf7-49be-bf9b-6c0c19e969cd"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public/"
  }
}
